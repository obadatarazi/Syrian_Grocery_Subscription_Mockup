# API base URL for backend integration.
# Production:
VITE_API_URL=https://api.aromacarekw.cloud/api
# Optional override for media files (/storage/...). Defaults to API origin without /api.
# VITE_MEDIA_BASE_URL=https://api.aromacarekw.cloud
# Storefront base URL used by "View on website" product links.
# VITE_STOREFRONT_URL=https://app.aromacarekw.cloud
# Local dev (Vite proxies /api → http://localhost:8000):
# VITE_API_URL=/api

# Set to "false" to use the Laravel backend instead of mock data.
VITE_USE_MOCKS=false
